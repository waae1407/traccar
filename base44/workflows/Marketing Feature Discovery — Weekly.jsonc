  "name": "Marketing Feature Discovery \u2014 Weekly",
  "description": "Reconciles the marketable feature catalog against live platform telemetry every Monday. New capabilities are proposed as unverified and disabled records for administrator review; nothing is advertised until it is verified.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "marketing_feature_discovery_weekly",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "discover_features": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "marketingFeatureDiscovery",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Discover marketable features",
            "description": "Proposes telemetry-evidenced capabilities for review"
          }
        }
      }
    ]
