{
  "name": "Vehicle Status Sync \u2014 Booking Status Changed",
  "description": "Automatically syncs Vehicle.status when BookingRequest.booking_status changes. Maps: approved/confirmed\u2192Reserved, active\u2192Active Rental, payment_due\u2192Payment Due, grace_period\u2192Grace Period, suspended\u2192Suspended, completed/cancelled\u2192Available.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"booking_status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "BookingRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vehicle_status_sync_booking_status_changed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncVehicleStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncVehicleStatus"
  }
}