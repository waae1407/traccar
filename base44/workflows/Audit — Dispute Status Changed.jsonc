{
  "name": "Audit \u2014 Dispute Status Changed",
  "description": "Writes ActivityEvent when Dispute.status changes. Covers admin-driven resolutions, evidence requests, and status transitions. Includes 2-minute dedup window to prevent double-writes when stripeWebhook also updates the same dispute.",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Dispute"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "audit_dispute_status_changed",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "auditDisputeStatus",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "auditDisputeStatus"
  }
}