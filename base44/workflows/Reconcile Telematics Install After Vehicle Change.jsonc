{
  "name": "Reconcile Telematics Install After Vehicle Change",
  "description": "Links pending telematics installs when a vehicle with a matching VIN is created or updated.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Vehicle"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reconcile_telematics_install_after_vehicle_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "reconcileUnlinkedTelematicsInstalls",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "reconcileUnlinkedTelematicsInstalls"
  }
}