{
  "name": "Auto-create payout communication threads",
  "description": "Creates payout discussion threads when payouts are held or fail.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"held\") or (.trigger.data.status == \"failed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "HostPayout"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_create_payout_communication_threads",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCreateCommunicationThread",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCreateCommunicationThread"
  }
}