{
  "name": "Traccar Position Sync \u2014 Hourly",
  "description": "Every 5 minutes: syncs live positions from Traccar, updates virtual odometer on active rental vehicles, and self-heals stale cached locations.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "traccar_position_sync_hourly",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_positions": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncTraccarDevicePositions",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Traccar positions",
            "description": "Updates GPS, odometer, and relay state for all devices"
          }
        }
      }
    ]
  }
}