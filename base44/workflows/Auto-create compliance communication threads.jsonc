{
  "name": "Auto-create compliance communication threads",
  "description": "Creates compliance request threads when documents need admin review or expire.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"pending_review\") or (.trigger.data.status == \"expired\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "HostVehicleCompliance"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_create_compliance_communication_threads",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoCreateCommunicationThread",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoCreateCommunicationThread"
  }
}