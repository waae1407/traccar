{
  "name": "Auto-geocode vehicle coordinates",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.city != null and .trigger.data.city != \"\" and .trigger.data.city != [] and .trigger.data.city != {}) and (.trigger.data.vehicle_lat == null or .trigger.data.vehicle_lat == \"\" or .trigger.data.vehicle_lat == [] or .trigger.data.vehicle_lat == {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Vehicle"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_geocode_vehicle_coordinates",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoGeocodeVehicle",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoGeocodeVehicle"
  }
}