{
  "name": "Host Approval Trigger",
  "description": "Fires when a host is approved \u2014 sends welcome email and sets up Stripe Connect",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"approved\") and (.trigger.changed_fields | index(\"status\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Host"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "host_approval_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "approveHost",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "approveHost"
  }
}