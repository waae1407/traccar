{
  "name": "GPSSubscription",
  "type": "object",
  "properties": {
    "customer_user_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "plan_name": {
      "type": "string"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "monthly_price": {
      "type": "number"
    },
    "annual_price": {
      "type": "number",
      "description": "Annual price if billing_cycle is annual"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "cancelled",
        "unpaid",
        "paused",
        "control_disabled",
        "deactivated"
      ],
      "default": "active"
    },
    "current_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "failed",
        "pending"
      ],
      "default": "paid"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "past_due_since": {
      "type": "string",
      "format": "date-time",
      "description": "When the subscription first went past_due"
    },
    "control_disabled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When remote controls were disabled due to non-payment (day 5)"
    },
    "tracking_disabled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When tracking was disabled due to non-payment (day 30)"
    },
    "dunning_email_count": {
      "type": "number",
      "default": 0,
      "description": "Number of dunning emails sent"
    },
    "last_dunning_email_at": {
      "type": "string",
      "format": "date-time"
    },
    "reactivated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When subscription was reactivated after payment update"
    }
  },
  "required": [
    "customer_email",
    "plan_name",
    "monthly_price"
  ]
}