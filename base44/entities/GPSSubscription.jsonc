{
  "name": "GPSSubscription",
  "type": "object",
  "properties": {
    "customer_user_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "plan_name": {
      "type": "string"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "monthly_price": {
      "type": "number"
    },
    "annual_price": {
      "type": "number",
      "description": "Annual price if billing_cycle is annual"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_payment_method_id": {
      "type": "string",
      "description": "Saved payment method from trial signup, used for $100 device fee if not returned"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "pending_activation",
        "past_due",
        "cancelled",
        "unpaid",
        "paused",
        "control_disabled",
        "deactivated"
      ],
      "default": "active"
    },
    "current_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "failed",
        "pending"
      ],
      "default": "paid"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "past_due_since": {
      "type": "string",
      "format": "date-time",
      "description": "When the subscription first went past_due"
    },
    "control_disabled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When remote controls were disabled due to non-payment (day 5)"
    },
    "tracking_disabled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When tracking was disabled due to non-payment (day 30)"
    },
    "dunning_email_count": {
      "type": "number",
      "default": 0,
      "description": "Number of dunning emails sent"
    },
    "last_dunning_email_at": {
      "type": "string",
      "format": "date-time"
    },
    "reactivated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When subscription was reactivated after payment update"
    },
    "trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 90-day free trial began. Null until the device comes online (or fallback deadline). Set by activatePendingTrials."
    },
    "trial_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 90-day trial ends and subscription auto-activates. Null until trial_started_at is set."
    },
    "trial_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 2-week trial-end reminder was sent (day 76)"
    },
    "trial_activation_deadline": {
      "type": "string",
      "format": "date-time",
      "description": "shipped_at + 21 days. If the device hasn't come online by this date, the trial starts from shipped_at as a fallback."
    },
    "device_first_online_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the linked device first reported online, triggering trial start."
    },
    "trial_start_source": {
      "type": "string",
      "enum": [
        "device_online",
        "fallback_ship_date",
        "signup_legacy"
      ],
      "description": "How the trial was started: device_online = device came online, fallback_ship_date = activation deadline passed, signup_legacy = old flow (pre-backorder change)."
    },
    "is_backordered": {
      "type": "boolean",
      "default": false,
      "description": "True if the order was placed when inventory was 0 (backorder). Trial doesn't start until device ships and comes online."
    },
    "canceled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user canceled their trial or subscription"
    },
    "cancel_reason": {
      "type": "string",
      "description": "Reason for cancellation"
    },
    "return_window_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "14-day deadline to return the device after cancellation"
    },
    "return_label_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the prepaid return label was emailed"
    },
    "device_return_warning_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the day-12 'device not received' warning was sent"
    },
    "device_returned_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the admin confirmed the device was returned"
    },
    "device_fee_charged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the $100 device-not-returned fee was charged"
    },
    "device_fee_amount": {
      "type": "number",
      "default": 100,
      "description": "Device fee charged if not returned within 14 days of cancellation"
    }
  },
  "required": [
    "customer_email",
    "plan_name",
    "monthly_price"
  ]
}