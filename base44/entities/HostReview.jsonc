{
  "name": "HostReview",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "booking_request_id": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_email": {
      "type": "string"
    },
    "renter_user_id": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "Legacy overall rating alias"
    },
    "overall_rating": {
      "type": "number"
    },
    "host_experience_rating": {
      "type": "number"
    },
    "vehicle_condition_rating": {
      "type": "number"
    },
    "cleanliness_rating": {
      "type": "number"
    },
    "communication_rating": {
      "type": "number"
    },
    "pickup_dropoff_rating": {
      "type": "number"
    },
    "would_rent_again": {
      "type": "boolean",
      "default": true
    },
    "review_text": {
      "type": "string"
    },
    "review_submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_confidence_weight": {
      "type": "number",
      "default": 1
    },
    "severe_dispute_flag": {
      "type": "boolean",
      "default": false
    },
    "review_source": {
      "type": "string",
      "enum": [
        "completed_booking_prompt",
        "admin_import",
        "legacy"
      ],
      "default": "completed_booking_prompt"
    },
    "host_response": {
      "type": "string"
    },
    "host_response_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "published",
        "flagged",
        "removed"
      ],
      "default": "pending"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "flagged",
        "hidden"
      ],
      "default": "pending"
    },
    "visibility_status": {
      "type": "string",
      "enum": [
        "hidden",
        "public",
        "admin_only"
      ],
      "default": "hidden"
    },
    "verified_booking": {
      "type": "boolean",
      "default": true
    },
    "dispute_adjusted_weight": {
      "type": "number",
      "default": 1
    },
    "fake_review_flag": {
      "type": "boolean",
      "default": false
    },
    "moderation_notes": {
      "type": "string"
    }
  },
  "required": [
    "host_id",
    "reviewer_email",
    "booking_request_id",
    "review_submitted_at"
  ],
  "unique_fields": [
    "booking_request_id"
  ]
}