{
  "name": "TelematicsSafetyEvent",
  "type": "object",
  "properties": {
    "alert_type": {
      "type": "string"
    },
    "alert_title": {
      "type": "string"
    },
    "alert_message": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety",
        "security",
        "device_health",
        "vehicle_health",
        "rental_compliance",
        "payment_risk",
        "operational"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "customer_severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical",
        "none"
      ]
    },
    "host_severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical",
        "none"
      ]
    },
    "admin_severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical",
        "none"
      ]
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_display_name": {
      "type": "string"
    },
    "vin": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "device_unique_id": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "rental_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lon": {
      "type": "number"
    },
    "address_label": {
      "type": "string"
    },
    "odometer": {
      "type": "number"
    },
    "speed": {
      "type": "number"
    },
    "battery_voltage": {
      "type": "number"
    },
    "fuel_level": {
      "type": "number"
    },
    "raw_packet_hex": {
      "type": "string"
    },
    "raw_packet_hex_latest": {
      "type": "string"
    },
    "packet_type": {
      "type": "string"
    },
    "packet_type_name": {
      "type": "string"
    },
    "parsed_payload_json": {
      "type": "object"
    },
    "source": {
      "type": "string",
      "enum": [
        "contactless360_device",
        "traccar",
        "webhook",
        "manual_admin",
        "booking_system",
        "payment_system",
        "command_system"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "acknowledged",
        "resolved",
        "dismissed_false_positive"
      ],
      "default": "new"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "occurrence_count": {
      "type": "number",
      "default": 1
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledged_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "visible_to_customer": {
      "type": "boolean",
      "default": false
    },
    "visible_to_host": {
      "type": "boolean",
      "default": false
    },
    "visible_to_admin": {
      "type": "boolean",
      "default": true
    },
    "notification_sent_sms": {
      "type": "boolean",
      "default": false
    },
    "notification_sent_email": {
      "type": "boolean",
      "default": false
    },
    "notification_sent_in_app": {
      "type": "boolean",
      "default": false
    },
    "escalation_level": {
      "type": "number",
      "default": 0
    },
    "last_escalated_at": {
      "type": "string",
      "format": "date-time"
    },
    "suppress_until": {
      "type": "string",
      "format": "date-time"
    },
    "linked_incident_id": {
      "type": "string"
    },
    "command_id": {
      "type": "string"
    },
    "command_type": {
      "type": "string"
    },
    "raw_ack_hex": {
      "type": "string"
    },
    "ack_status": {
      "type": "string"
    },
    "ack_match_confidence": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    }
  },
  "required": [
    "alert_type",
    "category",
    "severity",
    "first_seen_at"
  ]
}