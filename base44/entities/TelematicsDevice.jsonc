{
  "name": "TelematicsDevice",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "api",
        "traccar",
        "sms",
        "hybrid",
        "contactless360"
      ],
      "default": "api"
    },
    "unique_id": {
      "type": "string",
      "description": "Primary unique identifier \u2014 for contactless360 devices this is the IMEI"
    },
    "device_unique_id": {
      "type": "string",
      "description": "Alias for unique_id used by GPS activation flow"
    },
    "imei": {
      "type": "string"
    },
    "device_imei": {
      "type": "string"
    },
    "sim_iccid": {
      "type": "string"
    },
    "sim_provider": {
      "type": "string"
    },
    "provider_device_id": {
      "type": "string"
    },
    "traccar_device_id": {
      "type": "string"
    },
    "moovetrax_device_id": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "batch_number": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "vin": {
      "type": "string"
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "not_started",
        "activated",
        "partially_activated",
        "failed",
        "subscription_failed"
      ],
      "default": "not_started"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "cancelled",
        "unpaid",
        "paused",
        "none"
      ],
      "default": "none"
    },
    "supports_starter_interrupt": {
      "type": "boolean",
      "default": false
    },
    "supports_contactless": {
      "type": "boolean",
      "default": false
    },
    "installation_type": {
      "type": "string",
      "enum": [
        "self_installed",
        "professional_installed",
        "not_yet_installed"
      ],
      "default": "not_yet_installed"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "inventory",
        "provisioned",
        "assigned",
        "installation_started",
        "installation_completed",
        "installation_completed_unlinked",
        "live_ready",
        "live_enabled",
        "suspended",
        "retired"
      ],
      "default": "inventory"
    },
    "assigned_installer_id": {
      "type": "string"
    },
    "assigned_installer_email": {
      "type": "string"
    },
    "installation_scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "installation_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "live_enabled_at": {
      "type": "string",
      "format": "date-time"
    },
    "live_enabled_by": {
      "type": "string"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "retired"
      ],
      "default": "unassigned"
    },
    "install_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "installed",
        "failed",
        "correction_needed",
        "retired"
      ],
      "default": "not_started"
    },
    "online_status": {
      "type": "string",
      "enum": [
        "unknown",
        "online",
        "offline"
      ],
      "default": "unknown"
    },
    "ignition_status": {
      "type": "string",
      "enum": [
        "unknown",
        "on",
        "off"
      ],
      "default": "unknown"
    },
    "starter_disabled": {
      "type": "boolean",
      "default": false
    },
    "gps_enabled": {
      "type": "boolean",
      "default": true
    },
    "lock_unlock_enabled": {
      "type": "boolean",
      "default": false
    },
    "horn_light_enabled": {
      "type": "boolean",
      "default": false
    },
    "unlock_disarms_alarm": {
      "type": "boolean",
      "default": true
    },
    "unlock_double_pulse_enabled": {
      "type": "boolean",
      "default": false
    },
    "host_starter_control_enabled": {
      "type": "boolean",
      "default": false
    },
    "host_starter_control_approval_locked": {
      "type": "boolean",
      "default": false
    },
    "host_starter_control_approved_by": {
      "type": "string"
    },
    "host_starter_control_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "host_starter_control_lock_reason": {
      "type": "string"
    },
    "installer_starter_test_enabled": {
      "type": "boolean",
      "default": false
    },
    "production_commands_enabled": {
      "type": "boolean",
      "default": false
    },
    "production_enabled_at": {
      "type": "string",
      "format": "date-time"
    },
    "production_enabled_by": {
      "type": "string"
    },
    "production_command_scope": {
      "type": "string",
      "enum": [
        "non_starter_only",
        "all_supported_commands"
      ],
      "default": "non_starter_only"
    },
    "traccar_test_activation_enabled": {
      "type": "boolean",
      "default": false
    },
    "traccar_test_activation_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "traccar_test_activation_by": {
      "type": "string"
    },
    "traccar_test_activation_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_latitude": {
      "type": "number"
    },
    "last_longitude": {
      "type": "number"
    },
    "speed": {
      "type": "number"
    },
    "course": {
      "type": "number"
    },
    "heading": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "location_source": {
      "type": "string",
      "enum": [
        "traccar",
        "provider",
        "installer",
        "manual",
        "unknown"
      ],
      "default": "unknown"
    },
    "location_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "battery_level": {
      "type": "number"
    },
    "battery_voltage": {
      "type": "number"
    },
    "power_voltage": {
      "type": "number"
    },
    "external_voltage": {
      "type": "number"
    },
    "voltage": {
      "type": "number"
    },
    "voltage_source": {
      "type": "string"
    },
    "voltage_last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "signal_strength": {
      "type": "number"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_inbound_packet_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_inbound_packet_type": {
      "type": "string",
      "enum": [
        "handshake",
        "position",
        "alarm",
        "command_response",
        "heartbeat",
        "unknown"
      ]
    },
    "last_inbound_source": {
      "type": "string"
    },
    "last_inbound_raw_hex": {
      "type": "string"
    },
    "udp_session_fresh_until": {
      "type": "string",
      "format": "date-time"
    },
    "udp_session_status": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ],
      "default": "unknown"
    },
    "post_heartbeat_release_delay_seconds": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 30
    },
    "last_heartbeat_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_heartbeat_source_ip": {
      "type": "string"
    },
    "last_heartbeat_source_port": {
      "type": "string"
    },
    "smoke_detected": {
      "type": "boolean",
      "default": false
    },
    "smoke_voltage": {
      "type": "number"
    },
    "door_open": {
      "type": "boolean",
      "default": false
    },
    "trunk_open": {
      "type": "boolean",
      "default": false
    },
    "bluetooth_on": {
      "type": "boolean",
      "default": false
    },
    "hood_wire_voltage": {
      "type": "number"
    },
    "door_wire_voltage": {
      "type": "number"
    },
    "traccar_total_distance_meters": {
      "type": "number"
    },
    "device_mileage": {
      "type": "number"
    },
    "shock_alarm": {
      "type": "boolean",
      "default": false
    },
    "power_cut_alarm": {
      "type": "boolean",
      "default": false
    },
    "low_battery_alarm": {
      "type": "boolean",
      "default": false
    },
    "overspeed_alarm": {
      "type": "boolean",
      "default": false
    },
    "movement_alarm": {
      "type": "boolean",
      "default": false
    },
    "geofence_alarm": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "provider_key",
    "unique_id"
  ],
  "unique_fields": [
    "unique_id",
    "device_imei",
    "sim_iccid"
  ]
}