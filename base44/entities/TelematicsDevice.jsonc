{
  "name": "TelematicsDevice",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "provider_type": {
      "type": "string",
      "enum": [
        "api",
        "traccar",
        "sms",
        "hybrid"
      ],
      "default": "api"
    },
    "unique_id": {
      "type": "string"
    },
    "device_imei": {
      "type": "string"
    },
    "sim_iccid": {
      "type": "string"
    },
    "provider_device_id": {
      "type": "string"
    },
    "traccar_device_id": {
      "type": "string"
    },
    "moovetrax_device_id": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "batch_number": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "inventory",
        "provisioned",
        "assigned",
        "installation_started",
        "installation_completed",
        "installation_completed_unlinked",
        "live_ready",
        "live_enabled",
        "suspended",
        "retired"
      ],
      "default": "inventory"
    },
    "assigned_installer_id": {
      "type": "string"
    },
    "assigned_installer_email": {
      "type": "string"
    },
    "installation_scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "installation_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "live_enabled_at": {
      "type": "string",
      "format": "date-time"
    },
    "live_enabled_by": {
      "type": "string"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "retired"
      ],
      "default": "unassigned"
    },
    "install_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "installed",
        "failed",
        "retired"
      ],
      "default": "not_started"
    },
    "online_status": {
      "type": "string",
      "enum": [
        "unknown",
        "online",
        "offline"
      ],
      "default": "unknown"
    },
    "ignition_status": {
      "type": "string",
      "enum": [
        "unknown",
        "on",
        "off"
      ],
      "default": "unknown"
    },
    "starter_disabled": {
      "type": "boolean",
      "default": false
    },
    "gps_enabled": {
      "type": "boolean",
      "default": true
    },
    "lock_unlock_enabled": {
      "type": "boolean",
      "default": false
    },
    "horn_light_enabled": {
      "type": "boolean",
      "default": false
    },
    "production_commands_enabled": {
      "type": "boolean",
      "default": false
    },
    "production_enabled_at": {
      "type": "string",
      "format": "date-time"
    },
    "production_enabled_by": {
      "type": "string"
    },
    "production_command_scope": {
      "type": "string",
      "enum": [
        "non_starter_only",
        "all_supported_commands"
      ],
      "default": "non_starter_only"
    },
    "traccar_test_activation_enabled": {
      "type": "boolean",
      "default": false
    },
    "traccar_test_activation_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "traccar_test_activation_by": {
      "type": "string"
    },
    "traccar_test_activation_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_latitude": {
      "type": "number"
    },
    "last_longitude": {
      "type": "number"
    },
    "speed": {
      "type": "number"
    },
    "course": {
      "type": "number"
    },
    "heading": {
      "type": "number"
    },
    "address": {
      "type": "string"
    },
    "location_source": {
      "type": "string",
      "enum": [
        "traccar",
        "provider",
        "installer",
        "manual",
        "unknown"
      ],
      "default": "unknown"
    },
    "location_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "battery_level": {
      "type": "number"
    },
    "signal_strength": {
      "type": "number"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provider_key",
    "unique_id"
  ],
  "unique_fields": [
    "unique_id",
    "device_imei",
    "sim_iccid"
  ]
}