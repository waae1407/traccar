{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "host_id": {
      "type": "string",
      "description": "Host owner (if marketplace vehicle)"
    },
    "vin": {
      "type": "string",
      "description": "Vehicle Identification Number (unique)"
    },
    "plate": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "color": {
      "type": "string"
    },
    "purchase_price": {
      "type": "number"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_hours": {
      "type": "string"
    },
    "vehicle_lat": {
      "type": "number"
    },
    "vehicle_lon": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Reserved",
        "Active Rental",
        "Booked",
        "Payment Due",
        "Grace Period",
        "Suspended",
        "Maintenance",
        "Compliance Hold",
        "Transferred",
        "Out of Service",
        "Retired"
      ],
      "default": "Available"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "rental",
        "rto",
        "for_sale",
        "av_deployment"
      ],
      "default": "rental"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "buyout_price": {
      "type": "number"
    },
    "compliance_expires_at": {
      "type": "string",
      "format": "date"
    },
    "autonomous_capable": {
      "type": "boolean",
      "default": false
    },
    "av_platform": {
      "type": "string",
      "enum": [
        "none",
        "waymo",
        "tesla",
        "zoox",
        "other"
      ],
      "default": "none"
    },
    "remote_unlock_capable": {
      "type": "boolean",
      "default": false
    },
    "telematics_provider": {
      "type": "string",
      "enum": [
        "none",
        "moovetrax",
        "other"
      ],
      "default": "none"
    },
    "contactless_pickup": {
      "type": "boolean",
      "default": false
    },
    "deployment_type": {
      "type": "string",
      "enum": [
        "human",
        "av",
        "hybrid"
      ],
      "default": "human"
    },
    "mileage": {
      "type": "number"
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "weekly_rate": {
      "type": "number"
    },
    "daily_rate": {
      "type": "number"
    },
    "monthly_rate": {
      "type": "number"
    },
    "minimum_rental_days": {
      "type": "number",
      "default": 7
    },
    "maximum_rental_days": {
      "type": "number"
    },
    "rental_duration_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "default": "weekly"
    },
    "allow_daily_booking": {
      "type": "boolean",
      "default": false
    },
    "allow_weekly_booking": {
      "type": "boolean",
      "default": true
    },
    "allow_monthly_booking": {
      "type": "boolean",
      "default": false
    },
    "rent_to_own_eligible": {
      "type": "boolean",
      "default": false
    },
    "image_url": {
      "type": "string"
    },
    "current_city": {
      "type": "string",
      "description": "Deprecated \u2014 use city and state instead"
    },
    "moovetrax_device_id": {
      "type": "string"
    }
  },
  "required": [
    "make",
    "model",
    "year"
  ],
  "unique_fields": [
    "vin"
  ]
}