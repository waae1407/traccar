{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "vin": {
      "type": "string",
      "description": "Vehicle Identification Number (unique)"
    },
    "plate": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "color": {
      "type": "string"
    },
    "purchase_price": {
      "type": "number"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "vehicle_lat": {
      "type": "number",
      "description": "Vehicle location latitude (auto-geocoded from city, state)"
    },
    "vehicle_lon": {
      "type": "number",
      "description": "Vehicle location longitude (auto-geocoded from city, state)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Booked",
        "Maintenance",
        "Transferred"
      ],
      "default": "Available"
    },
    "mileage": {
      "type": "number"
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "weekly_rate": {
      "type": "number"
    },
    "rent_to_own_eligible": {
      "type": "boolean",
      "default": false
    },
    "image_url": {
      "type": "string"
    },
    "current_city": {
      "type": "string",
      "description": "Deprecated - use city and state instead"
    }
  },
  "required": [
    "make",
    "model",
    "year"
  ],
  "unique_fields": [
    "vin"
  ]
}