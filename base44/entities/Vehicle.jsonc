{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "host_id": {
      "type": "string",
      "description": "Required host owner for all bookable vehicles"
    },
    "vin": {
      "type": "string",
      "description": "Vehicle Identification Number (unique)"
    },
    "plate": {
      "type": "string"
    },
    "display_name": {
      "type": "string",
      "description": "Optional short vehicle label used on maps and fleet views."
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "color": {
      "type": "string"
    },
    "purchase_price": {
      "type": "number"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "pickup_address": {
      "type": "string"
    },
    "pickup_hours": {
      "type": "string"
    },
    "vehicle_lat": {
      "type": "number"
    },
    "vehicle_lon": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Reserved",
        "Active Rental",
        "Booked",
        "Payment Due",
        "Grace Period",
        "Suspended",
        "Maintenance",
        "Compliance Hold",
        "Transferred",
        "Out of Service",
        "Retired",
        "Dropoff Submitted",
        "Return Pending Host Review",
        "Dispute Hold",
        "Cleaning Hold",
        "Maintenance Hold"
      ],
      "default": "Available"
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "rental",
        "rto",
        "for_sale",
        "av_deployment"
      ],
      "default": "rental"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved"
    },
    "marketplace_visible": {
      "type": "boolean",
      "default": true,
      "description": "Host-controlled: whether this vehicle should appear on the uRide public marketplace. Ignored for Marketplace Partner plan (always on). Default OFF for FleetOS Professional."
    },
    "storefront_visible": {
      "type": "boolean",
      "default": true,
      "description": "Host-controlled: whether this vehicle appears on the host's own storefront."
    },
    "admin_marketplace_approved": {
      "type": "boolean",
      "default": true,
      "description": "Admin approval gate for marketplace listing. Set to false to remove from marketplace without changing operational status."
    },
    "buyout_price": {
      "type": "number"
    },
    "compliance_expires_at": {
      "type": "string",
      "format": "date"
    },
    "autonomous_capable": {
      "type": "boolean",
      "default": false
    },
    "av_platform": {
      "type": "string",
      "enum": [
        "none",
        "waymo",
        "tesla",
        "zoox",
        "other"
      ],
      "default": "none"
    },
    "remote_unlock_capable": {
      "type": "boolean",
      "default": false
    },
    "telematics_provider": {
      "type": "string",
      "enum": [
        "none",
        "moovetrax",
        "other"
      ],
      "default": "none"
    },
    "telematics_device_id": {
      "type": "string",
      "description": "Convenience reference to the active TelematicsDevice."
    },
    "contactless_pickup": {
      "type": "boolean",
      "default": false
    },
    "deployment_type": {
      "type": "string",
      "enum": [
        "human",
        "av",
        "hybrid"
      ],
      "default": "human"
    },
    "mileage": {
      "type": "number"
    },
    "baseline_odometer": {
      "type": "number",
      "description": "Manual odometer reading taken at time of GPS installation"
    },
    "baseline_odometer_set_at": {
      "type": "string",
      "format": "date-time"
    },
    "virtual_odometer": {
      "type": "number",
      "description": "Calculated: baseline_odometer + GPS distance delta"
    },
    "virtual_odometer_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "utilization_30d_avg_miles_per_day": {
      "type": "number",
      "default": 0
    },
    "projected_maintenance_date": {
      "type": "string",
      "format": "date"
    },
    "lifetime_active_rental_miles": {
      "type": "number",
      "default": 0
    },
    "lifetime_operational_idle_miles": {
      "type": "number",
      "default": 0
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "weekly_rate": {
      "type": "number"
    },
    "daily_rate": {
      "type": "number"
    },
    "monthly_rate": {
      "type": "number"
    },
    "minimum_rental_days": {
      "type": "number",
      "default": 7
    },
    "maximum_rental_days": {
      "type": "number"
    },
    "rental_duration_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "custom"
      ],
      "default": "weekly"
    },
    "allow_daily_booking": {
      "type": "boolean",
      "default": false
    },
    "allow_weekly_booking": {
      "type": "boolean",
      "default": true
    },
    "allow_monthly_booking": {
      "type": "boolean",
      "default": false
    },
    "rent_to_own_eligible": {
      "type": "boolean",
      "default": false
    },
    "smoking_allowed": {
      "type": "boolean",
      "default": false
    },
    "image_url": {
      "type": "string"
    },
    "current_city": {
      "type": "string",
      "description": "Deprecated \u2014 use city and state instead"
    },
    "moovetrax_device_id": {
      "type": "string"
    }
  },
  "required": [
    "host_id",
    "make",
    "model",
    "year",
    "mileage",
    "smoking_allowed"
  ],
  "unique_fields": [
    "vin"
  ]
}