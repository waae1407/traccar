{
  "name": "Booking",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Monthly",
        "Rent-to-Own"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "pickup_location": {
      "type": "string"
    },
    "dropoff_location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Reserved",
        "Active",
        "Completed",
        "Cancelled"
      ],
      "default": "Reserved"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "vehicle_id",
    "booking_type",
    "start_date"
  ]
}