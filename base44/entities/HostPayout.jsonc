{
  "name": "HostPayout",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "host_email": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "booking_request_id": {
      "type": "string",
      "description": "The booking that triggered this payout"
    },
    "vehicle_name": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "gross_booking_amount": {
      "type": "number",
      "default": 0,
      "description": "Total amount charged to customer"
    },
    "stripe_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Actual Stripe processing fee"
    },
    "stripe_effective_rate": {
      "type": "number",
      "default": 0,
      "description": "Stripe fee as percentage of gross"
    },
    "uride_platform_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Uride Platform Fee"
    },
    "uride_platform_fee_rate": {
      "type": "number",
      "default": 0.08,
      "description": "The commission_rate applied"
    },
    "receivable_offset_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount withheld from this payout to recover host receivables"
    },
    "net_host_payout": {
      "type": "number",
      "default": 0,
      "description": "gross - stripe_fee - uride_platform_fee - receivable offsets"
    },
    "gross_collected": {
      "type": "number",
      "default": 0,
      "description": "Legacy alias"
    },
    "platform_fee": {
      "type": "number",
      "default": 0,
      "description": "Legacy alias"
    },
    "net_payout": {
      "type": "number",
      "default": 0,
      "description": "Legacy alias"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "held",
        "released"
      ],
      "default": "pending"
    },
    "hold_reason": {
      "type": "string",
      "enum": [
        "dispute",
        "chargeback",
        "compliance",
        "admin_override",
        "reserve_window",
        ""
      ]
    },
    "hold_notes": {
      "type": "string"
    },
    "held_at": {
      "type": "string",
      "format": "date-time"
    },
    "held_by": {
      "type": "string"
    },
    "release_after": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    },
    "payout_date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_count": {
      "type": "number",
      "default": 0
    },
    "booking_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "host_id",
    "period_start",
    "period_end"
  ]
}