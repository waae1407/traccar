{
  "name": "HostPayout",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "host_email": {
      "type": "string"
    },
    "host_name": {
      "type": "string"
    },
    "booking_request_id": {
      "type": "string",
      "description": "The booking that triggered this payout"
    },
    "vehicle_name": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "gross_booking_amount": {
      "type": "number",
      "default": 0,
      "description": "Total amount charged to customer"
    },
    "stripe_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Actual Stripe processing fee"
    },
    "stripe_effective_rate": {
      "type": "number",
      "default": 0,
      "description": "Stripe fee as percentage of gross"
    },
    "uride_platform_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "Uride Platform Fee"
    },
    "uride_platform_fee_rate": {
      "type": "number",
      "default": 0.08,
      "description": "The commission_rate applied"
    },
    "receivable_offset_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount withheld from this payout to recover host receivables"
    },
    "net_host_payout": {
      "type": "number",
      "default": 0,
      "description": "gross - stripe_fee - uride_platform_fee - receivable offsets"
    },
    "gross_collected": {
      "type": "number",
      "default": 0,
      "description": "Legacy alias"
    },
    "platform_fee": {
      "type": "number",
      "default": 0,
      "description": "Legacy alias"
    },
    "net_payout": {
      "type": "number",
      "default": 0,
      "description": "Legacy alias"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "paid",
        "failed",
        "held",
        "released",
        "failed_requires_manual_review",
        "on_hold_stripe_balance",
        "voided_duplicate"
      ],
      "default": "pending"
    },
    "hold_reason": {
      "type": "string",
      "enum": [
        "dispute",
        "chargeback",
        "compliance",
        "admin_override",
        "reserve_window",
        "stripe_balance_insufficient",
        ""
      ]
    },
    "hold_notes": {
      "type": "string"
    },
    "held_at": {
      "type": "string",
      "format": "date-time"
    },
    "held_by": {
      "type": "string"
    },
    "release_after": {
      "type": "string",
      "format": "date-time"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    },
    "payout_date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_count": {
      "type": "number",
      "default": 0
    },
    "booking_count": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "retry_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts for this payout"
    },
    "max_retry_attempts": {
      "type": "number",
      "default": 3,
      "description": "Maximum retry attempts before manual review"
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "When next retry is scheduled"
    },
    "last_retry_at": {
      "type": "string",
      "format": "date-time",
      "description": "When last retry was attempted"
    },
    "failure_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attempted_at": {
            "type": "string",
            "format": "date-time"
          },
          "error_message": {
            "type": "string"
          },
          "retry_number": {
            "type": "number"
          }
        }
      },
      "description": "History of failure attempts"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Stripe transfer idempotency key"
    },
    "reconciliation_source": {
      "type": "boolean",
      "default": false,
      "description": "Whether this payout was created by reconciliation"
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "not_attempted",
        "would_process",
        "processed",
        "failed",
        "skipped"
      ],
      "default": "not_attempted"
    },
    "voided_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this payout was voided"
    },
    "voided_reason": {
      "type": "string",
      "description": "Reason for voiding"
    },
    "linked_primary_host_payout_id": {
      "type": "string",
      "description": "For duplicates: ID of primary payout record"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "updated_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "host_id",
    "period_start",
    "period_end"
  ]
}