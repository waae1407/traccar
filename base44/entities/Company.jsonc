{
  "name": "Company",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Internal company name"
    },
    "display_name": {
      "type": "string",
      "description": "Public-facing brand name"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier e.g. uride-houston"
    },
    "logo_url": {
      "type": "string",
      "description": "Full logo image URL"
    },
    "icon_url": {
      "type": "string",
      "description": "Small icon/favicon URL"
    },
    "primary_color": {
      "type": "string",
      "default": "#e91e8c",
      "description": "Brand primary color hex"
    },
    "secondary_color": {
      "type": "string",
      "default": "#7c3aed",
      "description": "Brand secondary color hex"
    },
    "support_email": {
      "type": "string"
    },
    "support_phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "starter",
        "growth",
        "enterprise"
      ],
      "default": "starter"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "active",
        "trialing",
        "past_due",
        "suspended",
        "cancelled"
      ],
      "default": "trialing"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "billing_email": {
      "type": "string"
    },
    "billing_name": {
      "type": "string"
    },
    "active_seat_count": {
      "type": "number",
      "default": 0
    },
    "max_seats": {
      "type": "number",
      "default": 5
    },
    "max_vehicles": {
      "type": "number",
      "default": 20
    },
    "max_monthly_bookings": {
      "type": "number",
      "default": 100
    },
    "plan_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "company_name",
    "slug"
  ]
}