{
  "name": "OperationalAlert",
  "type": "object",
  "properties": {
    "alert_type": {
      "type": "string",
      "enum": [
        "stale_gps",
        "device_offline",
        "command_failed",
        "command_expired",
        "command_acknowledged_not_executed",
        "qa_failure",
        "provisioning_failure",
        "installation_failure",
        "provider_health_warning",
        "vin_mismatch_install",
        "vin_not_found_installation",
        "compliance_expired",
        "host_documents_missing",
        "unresolved_dispute",
        "review_moderation_pending",
        "overdue_return",
        "dealer_network_issue",
        "maintenance_overdue",
        "missing_document"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "warning"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "notified",
        "acknowledged",
        "in_progress",
        "under_review",
        "waiting_on_host",
        "waiting_on_customer",
        "waiting_on_installer",
        "resolved",
        "dismissed",
        "closed",
        "escalated"
      ],
      "default": "new"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_role": {
      "type": "string",
      "enum": [
        "admin",
        "host",
        "customer",
        "installer",
        "system"
      ]
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "escalation_reason": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "source_entity_type": {
      "type": "string"
    },
    "source_entity_id": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "payments",
        "telematics",
        "fleet",
        "hosts",
        "customers",
        "installers",
        "dealer_network",
        "reputation",
        "compliance",
        "communications",
        "system"
      ],
      "default": "telematics"
    },
    "action_url": {
      "type": "string"
    },
    "communication_thread_id": {
      "type": "string"
    },
    "repeat_count": {
      "type": "number",
      "default": 1
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_duplicate_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_key": {
      "type": "string"
    },
    "telematics_device_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "command_id": {
      "type": "string"
    },
    "install_record_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "alert_type",
    "title",
    "message"
  ],
  "unique_fields": [
    "dedupe_key"
  ]
}