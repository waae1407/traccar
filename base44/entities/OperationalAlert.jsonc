{
  "name": "OperationalAlert",
  "type": "object",
  "properties": {
    "alert_type": {
      "type": "string",
      "enum": [
        "stale_gps",
        "device_offline",
        "command_failed",
        "command_expired",
        "command_acknowledged_not_executed",
        "qa_failure",
        "provisioning_failure",
        "installation_failure",
        "provider_health_warning",
        "vin_mismatch_install",
        "vin_not_found_installation",
        "compliance_expired",
        "host_documents_missing",
        "unresolved_dispute",
        "review_moderation_pending",
        "overdue_return",
        "dealer_network_issue",
        "maintenance_overdue",
        "missing_document",
        "pickup_inspection_incomplete",
        "rental_overdue",
        "return_review_required",
        "payment_failed",
        "pricing_mismatch",
        "overcharge_detected",
        "manual_refund_required",
        "payout_hold_created",
        "payout_correction_required",
        "host_payout_failed",
        "host_payout_sent",
        "weekly_billing_failed",
        "grace_period_started",
        "grace_period_expired",
        "starter_interrupt_sent",
        "telematics_power_cut",
        "smoke_impact_critical",
        "parser_error",
        "unknown_device",
        "unmatched_ack",
        "command_no_ack",
        "repeated_failures",
        "escalation_event",
        "booking_issues_detected",
        "payment_recovered",
        "fleetos_manual_payment_required",
        "stripe_account_restricted",
        "gps_offline_24h",
        "gps_offline_72h",
        "compliance_hold_active_booking",
        "chargeback_opened",
        "payout_held"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "warning"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "notified",
        "acknowledged",
        "in_progress",
        "under_review",
        "waiting_on_host",
        "waiting_on_customer",
        "waiting_on_installer",
        "resolved",
        "dismissed",
        "closed",
        "escalated"
      ],
      "default": "new"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_role": {
      "type": "string",
      "enum": [
        "admin",
        "host",
        "customer",
        "installer",
        "system"
      ]
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "escalation_reason": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "source_entity_type": {
      "type": "string"
    },
    "source_entity_id": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "payments",
        "telematics",
        "fleet",
        "hosts",
        "customers",
        "installers",
        "dealer_network",
        "reputation",
        "compliance",
        "communications",
        "system"
      ],
      "default": "telematics"
    },
    "action_url": {
      "type": "string"
    },
    "communication_thread_id": {
      "type": "string"
    },
    "repeat_count": {
      "type": "number",
      "default": 1
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_duplicate_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_key": {
      "type": "string"
    },
    "telematics_device_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "command_id": {
      "type": "string"
    },
    "install_record_id": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "related_booking_id": {
      "type": "string",
      "description": "BookingRequest ID related to this alert"
    },
    "related_customer_id": {
      "type": "string",
      "description": "Customer/user ID related to this alert"
    },
    "related_alert360_event_id": {
      "type": "string",
      "description": "TelematicsSafetyEvent ID for telematics alerts"
    },
    "financial_impact_amount": {
      "type": "number",
      "description": "Financial impact in USD"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "requires_admin_action": {
      "type": "boolean",
      "default": false
    },
    "requires_host_action": {
      "type": "boolean",
      "default": false
    },
    "requires_customer_action": {
      "type": "boolean",
      "default": false
    },
    "billing_context": {
      "type": "string",
      "enum": [
        "weekly_billing",
        "payment_recovery",
        "grace_period",
        "payout",
        "rental_payment",
        "fleetos_billing",
        "gps_fleet",
        "active_rental",
        "booking_monitor"
      ],
      "description": "Billing context for payment-related alerts"
    },
    "renter_email": {
      "type": "string",
      "description": "Renter/customer email for payment alerts"
    },
    "host_email": {
      "type": "string",
      "description": "Host email for payout alerts"
    },
    "retry_attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of retry attempts for payment alerts"
    },
    "escalation_deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for escalation"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Source function or system that created this alert"
    }
  },
  "required": [
    "alert_type",
    "title",
    "message"
  ],
  "unique_fields": [
    "dedupe_key"
  ]
}