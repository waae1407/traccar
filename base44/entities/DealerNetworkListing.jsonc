{
  "name": "DealerNetworkListing",
  "type": "object",
  "properties": {
    "seller_host_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vin": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "mileage": {
      "type": "number"
    },
    "asking_price": {
      "type": "number"
    },
    "mmr_value": {
      "type": "number"
    },
    "ai_price_guidance": {
      "type": "number"
    },
    "listing_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "under_offer",
        "sold",
        "removed"
      ],
      "default": "draft"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "internal_hosts",
        "public",
        "admin_only"
      ],
      "default": "internal_hosts"
    },
    "buyer_host_id": {
      "type": "string"
    },
    "sale_status": {
      "type": "string"
    },
    "platform_fee_amount": {
      "type": "number",
      "default": 50
    }
  },
  "required": [
    "seller_host_id"
  ]
}