{
  "name": "HostPlatformSubscription",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "operator_plan_id": {
      "type": "string"
    },
    "plan_mode": {
      "type": "string",
      "enum": [
        "fleetos_professional",
        "hybrid_growth",
        "marketplace_partner"
      ]
    },
    "billing_route": {
      "type": "string",
      "enum": [
        "subscription",
        "subscription_plus_marketplace",
        "commission",
        "none"
      ],
      "default": "none"
    },
    "status": {
      "type": "string",
      "enum": [
        "checkout_started",
        "trialing",
        "active",
        "past_due",
        "canceling",
        "canceled",
        "cancelled",
        "unpaid",
        "incomplete",
        "incomplete_expired",
        "paused",
        "expired",
        "not_required"
      ],
      "default": "checkout_started"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "checkout_started",
        "trialing",
        "active",
        "past_due",
        "canceling",
        "canceled",
        "cancelled",
        "unpaid",
        "incomplete",
        "incomplete_expired",
        "paused",
        "expired",
        "not_required"
      ],
      "default": "checkout_started"
    },
    "trial_active": {
      "type": "boolean",
      "default": false
    },
    "trial_days": {
      "type": "number",
      "default": 14
    },
    "trial_start_date": {
      "type": "string",
      "format": "date-time"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date-time"
    },
    "monthly_amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "stripe_product_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "stripe_invoice_id": {
      "type": "string"
    },
    "current_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_at_period_end": {
      "type": "boolean",
      "default": false
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_payment_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "paid",
        "failed",
        "past_due",
        "cancelled"
      ],
      "default": "pending"
    },
    "last_payment_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_payment_failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "billing_grace_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "self_service",
        "package_change",
        "webhook",
        "admin",
        "system"
      ],
      "default": "self_service"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "host_id",
    "plan_mode"
  ]
}