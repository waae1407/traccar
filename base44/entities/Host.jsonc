{
  "name": "Host",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "suspended",
        "rejected"
      ],
      "default": "pending"
    },
    "host_type": {
      "type": "string",
      "enum": [
        "single_host",
        "fleet_host",
        "pro_host",
        "enterprise"
      ],
      "default": "single_host"
    },
    "commission_rate": {
      "type": "number",
      "default": 0.08
    },
    "commission_rate_overridden_by_admin": {
      "type": "boolean",
      "default": false
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "payout_schedule": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "fleet_score": {
      "type": "number",
      "default": 100
    },
    "store_score": {
      "type": "number",
      "default": 0
    },
    "store_published": {
      "type": "boolean",
      "default": false
    },
    "total_vehicles": {
      "type": "number",
      "default": 0
    },
    "total_earnings": {
      "type": "number",
      "default": 0
    },
    "total_payouts": {
      "type": "number",
      "default": 0
    },
    "storefront_views": {
      "type": "number",
      "default": 0
    },
    "storefront_conversions": {
      "type": "number",
      "default": 0
    },
    "av_deployment_enabled": {
      "type": "boolean",
      "default": false
    },
    "badge_top_earner": {
      "type": "boolean",
      "default": false
    },
    "badge_fleet_first": {
      "type": "boolean",
      "default": false
    },
    "badge_five_star": {
      "type": "boolean",
      "default": false
    },
    "badge_av_pioneer": {
      "type": "boolean",
      "default": false
    },
    "badge_compliance_king": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "years_in_business": {
      "type": "number"
    },
    "referral_source": {
      "type": "string"
    },
    "id_front_url": {
      "type": "string"
    },
    "id_back_url": {
      "type": "string"
    },
    "selfie_url": {
      "type": "string"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "sole_proprietor",
        "llc",
        "s_corp",
        "c_corp",
        "partnership"
      ]
    },
    "ein_number": {
      "type": "string"
    },
    "ein_letter_url": {
      "type": "string"
    },
    "business_legal_name": {
      "type": "string"
    },
    "tax_classification": {
      "type": "string"
    },
    "ssn_last4": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_started",
        "docs_requested",
        "docs_submitted",
        "verified",
        "failed"
      ],
      "default": "not_started"
    },
    "verification_notes": {
      "type": "string"
    },
    "admin_viewed": {
      "type": "boolean",
      "default": false
    },
    "brand_builder_token": {
      "type": "string"
    },
    "logo_generations_used": {
      "type": "number",
      "default": 0
    },
    "logo_stripe_customer_id": {
      "type": "string"
    },
    "generated_logos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_icons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "payout_frozen": {
      "type": "boolean",
      "default": false,
      "description": "Admin-controlled: freeze all outgoing payouts for this host"
    },
    "booking_blocked": {
      "type": "boolean",
      "default": false,
      "description": "Admin-controlled: prevent new bookings on this host's vehicles"
    },
    "require_manual_approval": {
      "type": "boolean",
      "default": false,
      "description": "Admin-controlled: all new bookings require manual admin approval"
    },
    "host_under_review": {
      "type": "boolean",
      "default": false,
      "description": "Admin-controlled: host is under operational review"
    },
    "restriction_reason": {
      "type": "string",
      "description": "Reason for current operational restriction (required when setting restrictions)"
    },
    "restriction_admin_notes": {
      "type": "string",
      "description": "Internal admin notes on the restriction"
    },
    "restriction_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional: when the restriction automatically expires"
    },
    "restriction_set_by": {
      "type": "string",
      "description": "Admin email who set the restriction"
    },
    "restriction_set_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the restriction was set"
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}