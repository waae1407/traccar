{
  "name": "Host",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "suspended",
        "rejected"
      ],
      "default": "pending"
    },
    "host_type": {
      "type": "string",
      "enum": [
        "single_host",
        "fleet_host",
        "pro_host",
        "enterprise"
      ],
      "default": "single_host"
    },
    "commission_rate": {
      "type": "number",
      "default": 0.08,
      "description": "Uride Platform Fee rate (default 8%). Admin can override per host."
    },
    "commission_rate_overridden_by_admin": {
      "type": "boolean",
      "default": false,
      "description": "If true, admin has manually set a custom commission_rate and it should not be auto-migrated."
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "payout_schedule": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "fleet_score": {
      "type": "number",
      "default": 100
    },
    "store_score": {
      "type": "number",
      "default": 0
    },
    "store_published": {
      "type": "boolean",
      "default": false
    },
    "total_vehicles": {
      "type": "number",
      "default": 0
    },
    "total_earnings": {
      "type": "number",
      "default": 0
    },
    "total_payouts": {
      "type": "number",
      "default": 0
    },
    "storefront_views": {
      "type": "number",
      "default": 0
    },
    "storefront_conversions": {
      "type": "number",
      "default": 0
    },
    "av_deployment_enabled": {
      "type": "boolean",
      "default": false
    },
    "badge_top_earner": {
      "type": "boolean",
      "default": false
    },
    "badge_fleet_first": {
      "type": "boolean",
      "default": false
    },
    "badge_five_star": {
      "type": "boolean",
      "default": false
    },
    "badge_av_pioneer": {
      "type": "boolean",
      "default": false
    },
    "badge_compliance_king": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "years_in_business": {
      "type": "number"
    },
    "referral_source": {
      "type": "string"
    },
    "id_front_url": {
      "type": "string"
    },
    "id_back_url": {
      "type": "string"
    },
    "selfie_url": {
      "type": "string"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "sole_proprietor",
        "llc",
        "s_corp",
        "c_corp",
        "partnership"
      ]
    },
    "ein_number": {
      "type": "string"
    },
    "ein_letter_url": {
      "type": "string"
    },
    "business_legal_name": {
      "type": "string"
    },
    "tax_classification": {
      "type": "string"
    },
    "ssn_last4": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_started",
        "docs_requested",
        "docs_submitted",
        "verified",
        "failed"
      ],
      "default": "not_started"
    },
    "verification_notes": {
      "type": "string"
    },
    "admin_viewed": {
      "type": "boolean",
      "default": false
    },
    "brand_builder_token": {
      "type": "string",
      "description": "One-time token for the brand builder email link. Cleared once store goes live."
    }
  },
  "required": [
    "full_name",
    "email"
  ]
}