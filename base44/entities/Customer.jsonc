{
  "name": "Customer",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "driver_license_url": {
      "type": "string"
    },
    "id_upload_url": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "weekly_income": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Lead",
        "Approved",
        "Active",
        "Completed",
        "Blocked"
      ],
      "default": "Lead"
    },
    "notes": {
      "type": "string"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "Turo",
        "Facebook",
        "Referral",
        "Website",
        "Other"
      ]
    },
    "chargeback_count": {
      "type": "number",
      "default": 0,
      "description": "Number of Stripe chargebacks filed by or against this customer"
    },
    "dispute_count": {
      "type": "number",
      "default": 0,
      "description": "Total disputes opened involving this customer"
    }
  },
  "required": [
    "full_name",
    "phone"
  ]
}