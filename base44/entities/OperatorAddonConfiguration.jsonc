{
  "name": "OperatorAddonConfiguration",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "addon_key": {
      "type": "string",
      "enum": [
        "contactless_operations",
        "gps_telematics",
        "dealer_network",
        "vehicle_sourcing",
        "inventory_liquidation"
      ]
    },
    "addon_type": {
      "type": "string",
      "enum": [
        "contactless_operations",
        "gps_telematics",
        "dealer_network",
        "vehicle_sourcing",
        "inventory_liquidation"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "recommended",
        "interested",
        "selected",
        "pending_setup",
        "pending_billing_activation",
        "active",
        "paused",
        "cancelled",
        "removed",
        "suspended",
        "pending_payment"
      ],
      "default": "recommended"
    },
    "interest_status": {
      "type": "string",
      "enum": [
        "recommended",
        "interested",
        "selected",
        "removed"
      ],
      "default": "recommended"
    },
    "selected": {
      "type": "boolean",
      "default": false
    },
    "recommended": {
      "type": "boolean",
      "default": false
    },
    "selection_source": {
      "type": "string",
      "enum": [
        "questionnaire",
        "business_operations",
        "admin",
        "system"
      ],
      "default": "questionnaire"
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "not_activated",
        "pending_setup",
        "pending_payment",
        "active",
        "paused",
        "suspended",
        "cancelled"
      ],
      "default": "not_activated"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending_billing_activation",
        "pending_payment",
        "active",
        "past_due",
        "cancelled",
        "suspended"
      ],
      "default": "not_required"
    },
    "setup_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "blocked"
      ],
      "default": "not_started"
    },
    "one_time_price": {
      "type": "number",
      "default": 0
    },
    "one_time_amount": {
      "type": "number",
      "default": 0
    },
    "monthly_price": {
      "type": "number",
      "default": 0
    },
    "monthly_amount": {
      "type": "number",
      "default": 0
    },
    "per_vehicle_amount": {
      "type": "number",
      "default": 0
    },
    "annual_price": {
      "type": "number",
      "default": 0
    },
    "annual_amount": {
      "type": "number",
      "default": 0
    },
    "transaction_fee": {
      "type": "number",
      "default": 0
    },
    "transaction_fee_amount": {
      "type": "number",
      "default": 0
    },
    "pricing_note": {
      "type": "string"
    },
    "billing_impact": {
      "type": "string"
    },
    "operational_impact": {
      "type": "string"
    },
    "setup_note": {
      "type": "string"
    },
    "selected_at": {
      "type": "string",
      "format": "date-time"
    },
    "removed_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "audit_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "addon_key"
  ]
}