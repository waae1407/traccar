{
  "name": "Payment",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "payment_type": {
      "type": "string",
      "enum": [
        "Deposit",
        "Rental",
        "Late Fee"
      ]
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Card",
        "Cash",
        "Zelle",
        "ACH"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Paid",
        "Pending",
        "Failed",
        "Overdue"
      ],
      "default": "Pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "customer_id",
    "amount",
    "payment_type"
  ]
}