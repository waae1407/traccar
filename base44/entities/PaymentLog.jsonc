{
  "name": "PaymentLog",
  "type": "object",
  "properties": {
    "booking_request_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "week_number": {
      "type": "number"
    },
    "billing_period_start": {
      "type": "string",
      "format": "date"
    },
    "billing_period_end": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "stripe",
        "zelle",
        "cash",
        "cashapp",
        "venmo",
        "check",
        "other"
      ],
      "default": "stripe"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "stripe_webhook",
        "scheduled_billing",
        "grace_retry",
        "admin_manual",
        "admin_charge",
        "backfill",
        "manual_import",
        "unknown"
      ],
      "default": "unknown"
    },
    "source_confidence": {
      "type": "string",
      "enum": [
        "trusted",
        "partially_trusted",
        "unresolved"
      ],
      "default": "unresolved"
    },
    "legacy_flag": {
      "type": "boolean",
      "default": false
    },
    "external_reconcilable": {
      "type": "boolean",
      "default": false
    },
    "dedupe_key": {
      "type": "string"
    },
    "external_reference": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_payment_method_id": {
      "type": "string"
    },
    "stripe_balance_transaction_id": {
      "type": "string"
    },
    "stripe_receipt_url": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "paid",
        "failed",
        "refunded"
      ],
      "default": "paid"
    },
    "recorded_by": {
      "type": "string",
      "description": "autopay, admin email, webhook, or backfill source"
    },
    "notes": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "booking_request_id",
    "customer_email",
    "amount",
    "week_number"
  ]
}