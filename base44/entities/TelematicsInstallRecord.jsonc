{
  "name": "TelematicsInstallRecord",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "assigned_installer_email": {
      "type": "string"
    },
    "installer_email": {
      "type": "string"
    },
    "installer_phone": {
      "type": "string"
    },
    "installer_id": {
      "type": "string"
    },
    "telematics_device_id": {
      "type": "string"
    },
    "installer_name": {
      "type": "string"
    },
    "installer_signature_name": {
      "type": "string"
    },
    "install_token": {
      "type": "string"
    },
    "install_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "install_token_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "installer_access_status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked",
        "submitted"
      ],
      "default": "active"
    },
    "install_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "install_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "failed",
        "needs_review"
      ],
      "default": "not_started"
    },
    "qa_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_submitted"
    },
    "installation_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "installation_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "qa_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "qa_approved_by": {
      "type": "string"
    },
    "installation_notes": {
      "type": "string"
    },
    "voltage_verified": {
      "type": "boolean",
      "default": false
    },
    "gps_verified": {
      "type": "boolean",
      "default": false
    },
    "ignition_verified": {
      "type": "boolean",
      "default": false
    },
    "lock_unlock_verified": {
      "type": "boolean",
      "default": false
    },
    "tamper_check_verified": {
      "type": "boolean",
      "default": false
    },
    "gps_test_passed": {
      "type": "boolean",
      "default": false
    },
    "ignition_test_passed": {
      "type": "boolean",
      "default": false
    },
    "lock_test_passed": {
      "type": "boolean",
      "default": false
    },
    "unlock_test_passed": {
      "type": "boolean",
      "default": false
    },
    "horn_light_test_passed": {
      "type": "boolean",
      "default": false
    },
    "kill_restore_test_passed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "telematics_device_id"
  ],
  "unique_fields": [
    "install_token"
  ]
}