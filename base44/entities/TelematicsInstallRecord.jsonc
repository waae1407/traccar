{
  "name": "TelematicsInstallRecord",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vin": {
      "type": "string"
    },
    "vin_entered": {
      "type": "string"
    },
    "vehicle_match_status": {
      "type": "string",
      "enum": [
        "matched",
        "pending_vehicle_link"
      ],
      "default": "matched"
    },
    "assigned_installer_email": {
      "type": "string"
    },
    "installer_id": {
      "type": "string"
    },
    "installer_email": {
      "type": "string"
    },
    "installer_phone": {
      "type": "string"
    },
    "installer_business_name": {
      "type": "string"
    },
    "installer_business_address": {
      "type": "string"
    },
    "preferred_installer_lead_id": {
      "type": "string"
    },
    "verification_excluded": {
      "type": "boolean",
      "default": false
    },
    "verification_exclusion_reason": {
      "type": "string"
    },
    "telematics_device_id": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "device_unique_id": {
      "type": "string"
    },
    "installer_name": {
      "type": "string"
    },
    "installer_signature_name": {
      "type": "string"
    },
    "install_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "install_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "failed",
        "correction_needed",
        "unmatched_vin"
      ],
      "default": "not_started"
    },
    "qa_status": {
      "type": "string",
      "enum": [
        "not_required",
        "not_submitted",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_required"
    },
    "installation_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "installation_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "qa_approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "qa_approved_by": {
      "type": "string"
    },
    "installation_notes": {
      "type": "string"
    },
    "device_online": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "power_voltage_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "gps_signal_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "ignition_acc_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "lock_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_supported"
      ]
    },
    "unlock_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_supported"
      ]
    },
    "horn_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_supported"
      ]
    },
    "lights_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_supported"
      ]
    },
    "alarm_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_supported"
      ]
    },
    "starter_disable_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_supported"
      ]
    },
    "starter_restore_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_supported"
      ]
    },
    "tamper_security_test": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "test_summary": {
      "type": "object"
    },
    "failed_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voltage_verified": {
      "type": "boolean",
      "default": false
    },
    "gps_verified": {
      "type": "boolean",
      "default": false
    },
    "ignition_verified": {
      "type": "boolean",
      "default": false
    },
    "lock_unlock_verified": {
      "type": "boolean",
      "default": false
    },
    "tamper_check_verified": {
      "type": "boolean",
      "default": false
    },
    "gps_test_passed": {
      "type": "boolean",
      "default": false
    },
    "ignition_test_passed": {
      "type": "boolean",
      "default": false
    },
    "lock_test_passed": {
      "type": "boolean",
      "default": false
    },
    "unlock_test_passed": {
      "type": "boolean",
      "default": false
    },
    "horn_light_test_passed": {
      "type": "boolean",
      "default": false
    },
    "kill_restore_test_passed": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "telematics_device_id"
  ]
}