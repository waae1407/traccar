{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "customer",
        "admin"
      ],
      "default": "customer",
      "description": "User role - customer for public users, admin for CRM access"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether the account is active"
    },
    "driver_license_url": {
      "type": "string",
      "description": "Uploaded driver license file URL"
    },
    "id_upload_url": {
      "type": "string",
      "description": "Uploaded government ID file URL"
    },
    "customer_id": {
      "type": "string",
      "description": "Linked Customer entity ID"
    },
    "preferred_city": {
      "type": "string",
      "description": "Preferred rental city"
    },
    "saved_payment_method": {
      "type": "string",
      "description": "Saved payment method label"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last login timestamp"
    }
  }
}