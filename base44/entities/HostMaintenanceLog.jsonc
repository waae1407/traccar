{
  "name": "HostMaintenanceLog",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "oil_change",
        "tire_rotation",
        "brake_service",
        "inspection",
        "wash",
        "tire_replacement",
        "battery",
        "ac_service",
        "other"
      ],
      "default": "oil_change"
    },
    "cost": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "mileage_at_service": {
      "type": "number"
    },
    "next_service_mileage": {
      "type": "number",
      "description": "Odometer reading at which next service is due. Alert fires within 500 miles."
    },
    "next_service_date": {
      "type": "string",
      "format": "date"
    },
    "shop_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "receipt_verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "rejected"
      ],
      "default": "unverified"
    },
    "receipt_verified_by": {
      "type": "string"
    },
    "receipt_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "mileage_delta_since_last_service": {
      "type": "number"
    },
    "service_cadence_status": {
      "type": "string",
      "enum": [
        "on_track",
        "due_soon",
        "overdue",
        "unknown"
      ],
      "default": "unknown"
    },
    "maintenance_signal_confidence": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high"
      ],
      "default": "low"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "overdue"
      ],
      "default": "completed"
    }
  },
  "required": [
    "host_id",
    "vehicle_id",
    "service_type",
    "date"
  ]
}