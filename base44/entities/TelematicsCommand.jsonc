{
  "name": "TelematicsCommand",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "telematics_device_id": {
      "type": "string"
    },
    "provider_key": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "booking_id": {
      "type": "string"
    },
    "renter_id": {
      "type": "string"
    },
    "command_type": {
      "type": "string",
      "enum": [
        "locate",
        "lock",
        "unlock",
        "horn",
        "lights",
        "horn_lights",
        "disable_starter",
        "restore_starter",
        "status"
      ]
    },
    "provider_command_name": {
      "type": "string"
    },
    "provider_command_id": {
      "type": "string"
    },
    "ascii_payload": {
      "type": "string"
    },
    "hex_payload": {
      "type": "string"
    },
    "request_payload": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "sent",
        "delivered",
        "acknowledged",
        "executed",
        "failed",
        "expired",
        "blocked"
      ],
      "default": "queued"
    },
    "queue_status": {
      "type": "string",
      "enum": [
        "queued",
        "pending",
        "sending",
        "sent",
        "delivered",
        "acknowledged",
        "executed",
        "confirmed",
        "failed",
        "retrying",
        "expired",
        "blocked"
      ],
      "default": "queued"
    },
    "confirmation_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "acknowledged",
        "executed",
        "failed",
        "expired"
      ],
      "default": "pending"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "max_retries": {
      "type": "number",
      "default": 0
    },
    "next_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmation_required": {
      "type": "boolean",
      "default": false
    },
    "confirmation_source": {
      "type": "string"
    },
    "acknowledgement_source": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "requested_role": {
      "type": "string"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "failure_reason": {
      "type": "string"
    },
    "delivery_latency_ms": {
      "type": "number"
    },
    "execution_latency_ms": {
      "type": "number"
    },
    "provider_response": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "device_acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "failed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provider_key",
    "command_type",
    "requested_by"
  ],
  "unique_fields": [
    "idempotency_key"
  ]
}