{
  "name": "Notification",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "recipient_user_id": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "recipient_role": {
      "type": "string",
      "enum": [
        "admin",
        "host",
        "customer",
        "installer",
        "system"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "payments",
        "telematics",
        "fleet",
        "hosts",
        "customers",
        "installers",
        "dealer_network",
        "reputation",
        "compliance",
        "communications",
        "system"
      ],
      "default": "system"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info",
        "warning"
      ],
      "default": "info"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "booking",
        "payment",
        "verification",
        "contract",
        "system",
        "alert",
        "security",
        "telematics",
        "compliance",
        "communication",
        "dealer_network",
        "reputation"
      ],
      "default": "system"
    },
    "read_status": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    },
    "action_link": {
      "type": "string"
    },
    "action_url": {
      "type": "string"
    },
    "source_entity_type": {
      "type": "string"
    },
    "source_entity_id": {
      "type": "string"
    },
    "delivery_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "in_app",
          "email",
          "sms",
          "push"
        ]
      },
      "default": [
        "in_app"
      ]
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "delivered",
        "failed",
        "dismissed"
      ],
      "default": "pending"
    },
    "booking_request_id": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}