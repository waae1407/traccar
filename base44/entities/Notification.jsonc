{
  "name": "Notification",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "booking",
        "payment",
        "verification",
        "contract",
        "system",
        "alert"
      ],
      "default": "system"
    },
    "read_status": {
      "type": "boolean",
      "default": false
    },
    "action_link": {
      "type": "string"
    },
    "booking_request_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title",
    "body"
  ]
}