{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Recipient email address \u2014 data isolation key"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "booking",
        "payment",
        "alert",
        "system",
        "success"
      ],
      "default": "system"
    },
    "category": {
      "type": "string",
      "enum": [
        "bookings",
        "payments",
        "payouts",
        "gps",
        "compliance",
        "maintenance",
        "subscriptions",
        "verification",
        "contracts",
        "refunds",
        "system"
      ],
      "description": "Category for filtering in notification center"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "warning",
        "info"
      ],
      "description": "Severity level for sorting and display"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_archived": {
      "type": "boolean",
      "default": false
    },
    "archived_at": {
      "type": "string",
      "format": "date-time"
    },
    "booking_request_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "action_url": {
      "type": "string",
      "description": "Deep link URL for CTA button in notification center"
    }
  },
  "required": [
    "user_email",
    "title"
  ]
}