{
  "name": "GPSProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "brand_name": {
      "type": "string",
      "default": "Contactless360"
    },
    "sku": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package_type": {
      "type": "string",
      "enum": [
        "device_only",
        "device_subscription",
        "host_contactless_kit"
      ],
      "default": "device_subscription"
    },
    "device_price": {
      "type": "number",
      "default": 0,
      "description": "Effective charge price (sale_price if discount active, else msrp_price)"
    },
    "msrp_price": {
      "type": "number",
      "default": 0,
      "description": "Full retail / list price"
    },
    "sale_price": {
      "type": "number",
      "default": 0,
      "description": "Discounted sale price when is_discount_active=true"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "msrp_price - sale_price"
    },
    "discount_label": {
      "type": "string",
      "description": "e.g. Fleet Partner Launch Discount"
    },
    "discount_starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "discount_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_discount_active": {
      "type": "boolean",
      "default": false
    },
    "eligible_owner_type": {
      "type": "string",
      "enum": [
        "all",
        "host",
        "customer",
        "guest"
      ],
      "default": "all",
      "description": "Who may purchase this product"
    },
    "requires_approved_host": {
      "type": "boolean",
      "default": false,
      "description": "If true, purchaser must be a Host with status=approved"
    },
    "monthly_subscription_price": {
      "type": "number",
      "default": 0
    },
    "activation_fee": {
      "type": "number",
      "default": 0
    },
    "shipping_price": {
      "type": "number",
      "default": 0
    },
    "image_url": {
      "type": "string"
    },
    "inventory_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "requires_installation": {
      "type": "boolean",
      "default": true
    },
    "supports_starter_interrupt": {
      "type": "boolean",
      "default": true
    },
    "supports_contactless": {
      "type": "boolean",
      "default": true
    },
    "warranty_months": {
      "type": "number",
      "default": 12
    },
    "external_purchase_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "package_type"
  ]
}