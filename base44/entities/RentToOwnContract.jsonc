{
  "name": "RentToOwnContract",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name (denormalized)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle ID"
    },
    "vehicle_name": {
      "type": "string",
      "description": "Vehicle description (denormalized)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Contract start date"
    },
    "weekly_payment": {
      "type": "number",
      "description": "Weekly payment amount"
    },
    "total_contract_value": {
      "type": "number",
      "description": "Total contract value"
    },
    "total_paid": {
      "type": "number",
      "default": 0,
      "description": "Total amount paid so far"
    },
    "total_payments_required": {
      "type": "number",
      "default": 52,
      "description": "Number of consistent payments required for ownership"
    },
    "consistent_payments_made": {
      "type": "number",
      "default": 0,
      "description": "Number of consistent on-time payments"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "At Risk",
        "Completed",
        "Cancelled"
      ],
      "default": "Active",
      "description": "Contract status"
    }
  },
  "required": [
    "customer_id",
    "vehicle_id",
    "weekly_payment",
    "total_contract_value"
  ]
}