{
  "name": "RentToOwnContract",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "weekly_payment": {
      "type": "number"
    },
    "total_contract_value": {
      "type": "number"
    },
    "total_paid": {
      "type": "number",
      "default": 0
    },
    "total_payments_required": {
      "type": "number",
      "default": 52
    },
    "consistent_payments_made": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "At Risk",
        "Completed",
        "Cancelled"
      ],
      "default": "Active"
    }
  },
  "required": [
    "customer_id",
    "vehicle_id",
    "weekly_payment",
    "total_contract_value"
  ]
}