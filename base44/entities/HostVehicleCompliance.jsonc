{
  "name": "HostVehicleCompliance",
  "type": "object",
  "properties": {
    "host_id": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "insurance",
        "registration",
        "inspection",
        "title"
      ],
      "default": "insurance"
    },
    "doc_url": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "expiring_soon",
        "expired",
        "pending_review"
      ],
      "default": "pending_review"
    },
    "verified_by_admin": {
      "type": "boolean",
      "default": false
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "renewal_submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "renewal_timeliness_status": {
      "type": "string",
      "enum": [
        "early",
        "on_time",
        "late",
        "unknown"
      ],
      "default": "unknown"
    },
    "compliance_streak_days": {
      "type": "number",
      "default": 0
    },
    "active_rental_gap_flag": {
      "type": "boolean",
      "default": false
    },
    "admin_verification_recency_days": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "host_id",
    "vehicle_id",
    "doc_type"
  ]
}