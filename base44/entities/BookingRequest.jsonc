{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "host_id": {
      "type": "string",
      "description": "Host owner resolved from the selected vehicle"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "vehicle_image": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "booking_source": {
      "type": "string",
      "enum": [
        "marketplace",
        "direct",
        "admin_created",
        "imported",
        "dealer_network"
      ],
      "default": "marketplace"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Monthly",
        "Rent-to-Own",
        "Commercial"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "Mirrors end_date + 23:59:59. Used for lifecycle processing."
    },
    "auto_renew": {
      "type": "boolean",
      "default": true
    },
    "pickup_location": {
      "type": "string"
    },
    "dropoff_location": {
      "type": "string"
    },
    "delivery_requested": {
      "type": "boolean",
      "default": false
    },
    "airport_delivery": {
      "type": "boolean",
      "default": false
    },
    "booking_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_verification",
        "pending_contract",
        "pending_payment",
        "pending_review",
        "confirmed",
        "checked_out",
        "active",
        "return_required",
        "post_inspection_required",
        "overdue_return",
        "return_pending_host_review",
        "payment_due",
        "grace_period",
        "completed",
        "cancelled",
        "under_review",
        "suspended",
        "approved",
        "rejected",
        "more_info_requested",
        "cancellation_requested",
        "superseded_invalid"
      ],
      "default": "draft"
    },
    "rental_lifecycle_phase": {
      "type": "string",
      "enum": [
        "payment_complete",
        "pickup_required",
        "checked_out",
        "active",
        "return_required",
        "return_in_progress",
        "host_review",
        "completed",
        "superseded",
        "cancelled"
      ],
      "description": "Derived rental lifecycle phase \u2014 source of truth for vehicle availability and My Vehicle access. Do not infer from timestamps alone."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending",
        "paid",
        "failed",
        "overdue",
        "due_soon",
        "refunded"
      ],
      "default": "unpaid"
    },
    "checkout_step": {
      "type": "string",
      "enum": [
        "select_vehicle",
        "account",
        "profile",
        "verification",
        "terms",
        "contract",
        "payment",
        "confirmation"
      ],
      "default": "select_vehicle"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_started",
        "submitted",
        "verified",
        "failed",
        "manual_review"
      ],
      "default": "not_started"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "in_review",
        "approved",
        "rejected",
        "more_info_requested"
      ],
      "default": "unassigned"
    },
    "assigned_admin_user_id": {
      "type": "string"
    },
    "assigned_team": {
      "type": "string"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_notes": {
      "type": "string"
    },
    "weekly_rate": {
      "type": "number"
    },
    "monthly_rate": {
      "type": "number"
    },
    "deposit_amount": {
      "type": "number"
    },
    "first_payment_amount": {
      "type": "number"
    },
    "total_due_now": {
      "type": "number"
    },
    "consent_esign": {
      "type": "boolean",
      "default": false
    },
    "consent_verification": {
      "type": "boolean",
      "default": false
    },
    "consent_terms": {
      "type": "boolean",
      "default": false
    },
    "consent_autopay": {
      "type": "boolean",
      "default": false
    },
    "customer_full_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_dob": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "income_range": {
      "type": "string"
    },
    "license_front_url": {
      "type": "string"
    },
    "license_back_url": {
      "type": "string"
    },
    "selfie_url": {
      "type": "string"
    },
    "proof_of_income_url": {
      "type": "string"
    },
    "contract_html": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "weekly",
        "rent_to_own",
        "weekly_rental",
        "monthly_rental",
        "commercial_fleet"
      ]
    },
    "contract_version": {
      "type": "string"
    },
    "contract_initials": {
      "type": "string"
    },
    "signature_name": {
      "type": "string"
    },
    "signature_ip_address": {
      "type": "string"
    },
    "signature_device_info": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "not_generated",
        "generated",
        "signed"
      ],
      "default": "not_generated"
    },
    "notes": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "pending_referral_credit": {
      "type": "number",
      "default": 0
    },
    "abandoned_checkout": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_by_admin": {
      "type": "boolean",
      "default": false
    },
    "pending_review_alert_active": {
      "type": "boolean",
      "default": true
    },
    "admin_attention_priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ],
      "default": "high"
    },
    "admin_notes": {
      "type": "string"
    },
    "is_superseded": {
      "type": "boolean",
      "default": false,
      "description": "Structured control: true when this booking has been replaced by another booking and should be excluded from recovery automation. Notes are informational only."
    },
    "superseded_by_booking_id": {
      "type": "string",
      "description": "Booking ID that replaced this booking, when known."
    },
    "superseded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this booking was superseded."
    },
    "superseded_reason": {
      "type": "string",
      "description": "Reason for superseding: duplicate_booking_created_during_unresolved_return, replaced_booking, etc."
    },
    "closure_reason": {
      "type": "string",
      "enum": [
        "superseded",
        "stale_booking",
        "duplicate_booking",
        "replaced_booking",
        "manually_closed",
        "auto_cancelled",
        "historical_migration"
      ],
      "description": "Structured closure reason used by automation instead of parsing notes."
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_setup_intent_id": {
      "type": "string"
    },
    "stripe_payment_method_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_transfer_id": {
      "type": "string",
      "description": "Stripe transfer ID for the host payout."
    },
    "receipt_url": {
      "type": "string"
    },
    "autopay_enabled": {
      "type": "boolean",
      "default": true
    },
    "payment_failure_reason": {
      "type": "string"
    },
    "payment_failure_attempts": {
      "type": "number",
      "default": 0
    },
    "last_payment_failure_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_failure_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Official start of the 2-hour payment recovery window"
    },
    "starter_disable_scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When starter access should be disabled if payment remains failed"
    },
    "starter_disabled": {
      "type": "boolean",
      "default": false,
      "description": "Clear starter-interrupt state; keep moovetrax_kill_active for backward compatibility"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date"
    },
    "billing_week_number": {
      "type": "number",
      "default": 1
    },
    "agreement_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "agreement_ip_address": {
      "type": "string"
    },
    "agreement_device_info": {
      "type": "string"
    },
    "agreement_version": {
      "type": "string"
    },
    "payment_accepted_recurring_notice": {
      "type": "boolean",
      "default": false
    },
    "platform_fee_amount": {
      "type": "number",
      "description": "Platform commission fee for this booking."
    },
    "host_payout_amount": {
      "type": "number",
      "description": "Net amount paid to host after fees."
    },
    "stripe_fee_amount": {
      "type": "number",
      "description": "Stripe processing fee for this booking."
    },
    "host_payout_status": {
      "type": "string",
      "enum": [
        "not_eligible",
        "pending",
        "paid",
        "failed",
        "on_hold"
      ],
      "default": "not_eligible",
      "description": "Host payout lifecycle. pending = payout owed but not yet processed. paid = Stripe transfer sent. failed = transfer attempted and failed. on_hold = blocked by dispute/refund/admin. not_eligible = booking not yet paid or cancelled."
    },
    "payout_failure_reason": {
      "type": "string",
      "description": "Error message when host_payout_status is failed."
    },
    "payout_processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the host payout was successfully processed."
    },
    "pickup_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pickup_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When pickup inspection was completed. Alias for pickup_completed_at."
    },
    "pickup_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When pickup pre-inspection was completed."
    },
    "pickup_location_lat": {
      "type": "number"
    },
    "pickup_location_lon": {
      "type": "number"
    },
    "pickup_location_label": {
      "type": "string"
    },
    "return_interior_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "return_exterior_photos": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dropoff_submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "dropoff_location_lat": {
      "type": "number"
    },
    "dropoff_location_lon": {
      "type": "number"
    },
    "dropoff_location_label": {
      "type": "string"
    },
    "clean_return_status": {
      "type": "string",
      "enum": [
        "not_returned",
        "photos_submitted",
        "approved_clean",
        "not_clean",
        "fee_applied"
      ],
      "default": "not_returned"
    },
    "return_required_at": {
      "type": "string",
      "format": "date-time",
      "description": "When end_date passed and return photos were not yet submitted."
    },
    "return_inspection_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When customer opened the return inspection flow."
    },
    "return_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When return photos were submitted within geofence."
    },
    "return_photo_lat": {
      "type": "number",
      "description": "GPS lat captured with return photos."
    },
    "return_photo_lon": {
      "type": "number",
      "description": "GPS lon captured with return photos."
    },
    "return_distance_from_pickup_miles": {
      "type": "number",
      "description": "Distance from return GPS to pickup/return location in miles."
    },
    "post_inspection_geofence_verified": {
      "type": "boolean",
      "default": false,
      "description": "True when return photos were submitted within the 5-mile geofence."
    },
    "billing_stopped_at": {
      "type": "string",
      "format": "date-time",
      "description": "When billing was stopped (return_completed_at or admin override)."
    },
    "billing_stop_reason": {
      "type": "string",
      "enum": [
        "post_inspection_completed",
        "admin_override",
        "host_approved_return",
        "auto_completed"
      ],
      "description": "Why billing was stopped."
    },
    "host_review_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for host to review return: return_completed_at + 24 hours."
    },
    "host_review_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When host completed the return review."
    },
    "host_review_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "damage_reported",
        "disputed",
        "auto_completed",
        "admin_review_requested"
      ],
      "default": "pending",
      "description": "Host review outcome."
    },
    "auto_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When booking was auto-completed after host review window expired."
    },
    "completion_reason": {
      "type": "string",
      "enum": [
        "host_approved_return",
        "host_review_window_expired",
        "admin_override",
        "auto_completed",
        "historical_migration"
      ],
      "description": "Why the booking was completed."
    },
    "damage_dispute_deadline_at": {
      "type": "string",
      "format": "date-time",
      "description": "Deadline for host to open a damage dispute after auto-complete: return_completed_at + 24 hours."
    },
    "damage_dispute_allowed_after_auto_complete": {
      "type": "boolean",
      "default": false,
      "description": "Whether host can still open a damage dispute after auto-completion."
    },
    "damage_dispute_opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "damage_dispute_status": {
      "type": "string",
      "enum": [
        "none",
        "open",
        "resolved",
        "rejected",
        "admin_exception_required"
      ],
      "default": "none"
    },
    "vehicle_moved_after_return_at": {
      "type": "string",
      "format": "date-time",
      "description": "When system detected vehicle moved >5 miles from return photo location."
    },
    "vehicle_distance_from_return_miles": {
      "type": "number",
      "description": "Distance from return photo location to current vehicle GPS."
    },
    "lifecycle_audit_notes": {
      "type": "string",
      "description": "Internal audit notes for lifecycle events."
    },
    "moovetrax_kill_active": {
      "type": "boolean",
      "default": false
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "rental_ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "rental_ended_by": {
      "type": "string"
    },
    "grace_period_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "grace_period_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_retry_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspension_triggered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "vehicle_id",
    "booking_type"
  ]
}