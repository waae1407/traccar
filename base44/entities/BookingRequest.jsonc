{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Owning company"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string"
    },
    "vehicle_name": {
      "type": "string"
    },
    "vehicle_image": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Monthly",
        "Rent-to-Own"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "auto_renew": {
      "type": "boolean",
      "default": true
    },
    "pickup_location": {
      "type": "string"
    },
    "dropoff_location": {
      "type": "string"
    },
    "delivery_requested": {
      "type": "boolean",
      "default": false
    },
    "airport_delivery": {
      "type": "boolean",
      "default": false
    },
    "booking_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_verification",
        "pending_contract",
        "pending_payment",
        "pending_review",
        "confirmed",
        "active",
        "completed",
        "cancelled",
        "under_review",
        "suspended",
        "approved",
        "rejected",
        "more_info_requested",
        "cancellation_requested"
      ],
      "default": "draft"
    },
    "cancellation_reason": {
      "type": "string"
    },
    "cancellation_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_started",
        "submitted",
        "verified",
        "failed",
        "manual_review"
      ],
      "default": "not_started"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending",
        "paid",
        "failed",
        "overdue",
        "due_soon",
        "refunded"
      ],
      "default": "unpaid"
    },
    "checkout_step": {
      "type": "string",
      "enum": [
        "select_vehicle",
        "account",
        "profile",
        "verification",
        "terms",
        "contract",
        "payment",
        "confirmation"
      ],
      "default": "select_vehicle"
    },
    "assigned_admin_user_id": {
      "type": "string"
    },
    "assigned_team": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "assigned",
        "in_review",
        "approved",
        "rejected",
        "more_info_requested"
      ],
      "default": "unassigned"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_notes": {
      "type": "string"
    },
    "weekly_rate": {
      "type": "number"
    },
    "deposit_amount": {
      "type": "number"
    },
    "first_payment_amount": {
      "type": "number"
    },
    "total_due_now": {
      "type": "number"
    },
    "consent_esign": {
      "type": "boolean",
      "default": false
    },
    "consent_verification": {
      "type": "boolean",
      "default": false
    },
    "consent_terms": {
      "type": "boolean",
      "default": false
    },
    "consent_autopay": {
      "type": "boolean",
      "default": false,
      "description": "Mandatory autopay authorization signed at checkout"
    },
    "consent_autopay_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of autopay consent"
    },
    "consent_autopay_ip": {
      "type": "string",
      "description": "IP address at autopay consent"
    },
    "customer_full_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_dob": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "income_range": {
      "type": "string"
    },
    "license_front_url": {
      "type": "string"
    },
    "license_back_url": {
      "type": "string"
    },
    "selfie_url": {
      "type": "string"
    },
    "proof_of_income_url": {
      "type": "string"
    },
    "contract_html": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "weekly",
        "rent_to_own"
      ],
      "description": "Type of contract signed"
    },
    "contract_version": {
      "type": "string",
      "description": "Version of the contract signed"
    },
    "contract_initials": {
      "type": "string",
      "description": "JSON string of per-clause initials with timestamps"
    },
    "signature_name": {
      "type": "string"
    },
    "signature_ip_address": {
      "type": "string"
    },
    "signature_device_info": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "not_generated",
        "generated",
        "signed"
      ],
      "default": "not_generated"
    },
    "notes": {
      "type": "string"
    },
    "abandoned_checkout": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "viewed_by_admin": {
      "type": "boolean",
      "default": false
    },
    "first_viewed_by_admin_at": {
      "type": "string",
      "format": "date-time"
    },
    "pending_review_alert_active": {
      "type": "boolean",
      "default": true
    },
    "admin_attention_priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ],
      "default": "high"
    },
    "admin_notes": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_setup_intent_id": {
      "type": "string"
    },
    "stripe_payment_method_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "receipt_url": {
      "type": "string"
    },
    "autopay_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Always true \u2014 set automatically when autopay consent is given"
    },
    "payment_failure_reason": {
      "type": "string"
    },
    "payment_failure_attempts": {
      "type": "number",
      "default": 0,
      "description": "Number of failed payment retry attempts"
    },
    "last_payment_failure_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_billing_date": {
      "type": "string",
      "format": "date",
      "description": "Next scheduled weekly charge date"
    },
    "billing_week_number": {
      "type": "number",
      "default": 1,
      "description": "Current week number of rental"
    },
    "agreement_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "agreement_ip_address": {
      "type": "string"
    },
    "agreement_device_info": {
      "type": "string"
    },
    "agreement_version": {
      "type": "string"
    },
    "payment_accepted_recurring_notice": {
      "type": "boolean",
      "default": false
    },
    "pickup_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Baseline vehicle condition photos taken at pickup"
    },
    "return_interior_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer-uploaded interior photos at return"
    },
    "return_exterior_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer-uploaded exterior photos at return"
    },
    "clean_return_status": {
      "type": "string",
      "enum": [
        "not_returned",
        "photos_submitted",
        "approved_clean",
        "not_clean",
        "fee_applied"
      ],
      "default": "not_returned",
      "description": "Admin review status for clean return incentive"
    },
    "clean_return_credit_issued": {
      "type": "boolean",
      "default": false
    },
    "clean_return_admin_notes": {
      "type": "string"
    },
    "inspection_sample_images": {
      "type": "object",
      "description": "Pre-generated inspection sample image URLs keyed by slot ID",
      "properties": {
        "interior_front": {
          "type": "string"
        },
        "interior_rear": {
          "type": "string"
        },
        "exterior_front_left": {
          "type": "string"
        },
        "exterior_rear_left": {
          "type": "string"
        },
        "exterior_front_right": {
          "type": "string"
        },
        "exterior_rear_right": {
          "type": "string"
        }
      }
    },
    "moovetrax_kill_active": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Moovetrax kill switch is currently active"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the rental was suspended due to payment failure"
    },
    "reinstate_url_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When reinstate payment link was last sent to customer"
    }
  },
  "required": [
    "vehicle_id",
    "booking_type"
  ]
}