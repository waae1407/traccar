{
  "name": "BookingRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID"
    },
    "user_email": {
      "type": "string",
      "description": "User email (denormalized)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle ID"
    },
    "vehicle_name": {
      "type": "string",
      "description": "Vehicle name (denormalized)"
    },
    "vehicle_image": {
      "type": "string",
      "description": "Vehicle image URL"
    },
    "city": {
      "type": "string",
      "description": "Pickup city"
    },
    "booking_type": {
      "type": "string",
      "enum": [
        "Daily",
        "Weekly",
        "Monthly",
        "Rent-to-Own"
      ],
      "description": "Type of booking"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date"
    },
    "pickup_location": {
      "type": "string",
      "description": "Pickup address or location"
    },
    "dropoff_location": {
      "type": "string",
      "description": "Dropoff address or location"
    },
    "delivery_requested": {
      "type": "boolean",
      "default": false
    },
    "airport_delivery": {
      "type": "boolean",
      "default": false
    },
    "booking_status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_verification",
        "pending_contract",
        "pending_payment",
        "pending_review",
        "confirmed",
        "active",
        "completed",
        "cancelled",
        "under_review",
        "suspended",
        "approved",
        "rejected",
        "more_info_requested"
      ],
      "default": "draft"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_started",
        "submitted",
        "verified",
        "failed",
        "manual_review"
      ],
      "default": "not_started"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "pending",
        "paid",
        "failed",
        "overdue",
        "due_soon"
      ],
      "default": "unpaid"
    },
    "checkout_step": {
      "type": "string",
      "enum": [
        "select_vehicle",
        "account",
        "profile",
        "verification",
        "terms",
        "contract",
        "payment",
        "confirmation"
      ],
      "default": "select_vehicle"
    },
    "weekly_rate": {
      "type": "number",
      "description": "Weekly rate"
    },
    "deposit_amount": {
      "type": "number",
      "description": "Deposit amount"
    },
    "first_payment_amount": {
      "type": "number",
      "description": "First payment due now"
    },
    "total_due_now": {
      "type": "number",
      "description": "Total due at checkout"
    },
    "consent_esign": {
      "type": "boolean",
      "default": false
    },
    "consent_verification": {
      "type": "boolean",
      "default": false
    },
    "consent_terms": {
      "type": "boolean",
      "default": false
    },
    "customer_full_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_dob": {
      "type": "string",
      "format": "date"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "employer": {
      "type": "string"
    },
    "income_range": {
      "type": "string"
    },
    "license_front_url": {
      "type": "string"
    },
    "license_back_url": {
      "type": "string"
    },
    "selfie_url": {
      "type": "string"
    },
    "proof_of_income_url": {
      "type": "string"
    },
    "contract_html": {
      "type": "string",
      "description": "Generated contract content"
    },
    "signature_name": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "not_generated",
        "generated",
        "signed"
      ],
      "default": "not_generated"
    },
    "notes": {
      "type": "string"
    },
    "abandoned_checkout": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When customer submitted the booking"
    },
    "viewed_by_admin": {
      "type": "boolean",
      "default": false,
      "description": "Has an admin opened this booking"
    },
    "first_viewed_by_admin_at": {
      "type": "string",
      "format": "date-time"
    },
    "pending_review_alert_active": {
      "type": "boolean",
      "default": true,
      "description": "Show in admin post-it alert area"
    },
    "admin_attention_priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ],
      "default": "high"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes on this booking"
    }
  },
  "required": [
    "vehicle_id",
    "booking_type"
  ]
}