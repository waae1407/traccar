{
  "name": "GPSOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "customer_user_id": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "order_owner_type": {
      "type": "string",
      "enum": [
        "host",
        "customer",
        "guest"
      ],
      "default": "guest",
      "description": "Whether the order was placed by a host, authenticated customer, or guest"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "shipping_address": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "package_type": {
      "type": "string",
      "enum": [
        "device_only",
        "device_subscription",
        "host_contactless_kit"
      ]
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "msrp_unit_price": {
      "type": "number",
      "default": 0,
      "description": "Full retail price per unit"
    },
    "sale_unit_price": {
      "type": "number",
      "default": 0,
      "description": "Discounted price per unit (equals msrp if no discount)"
    },
    "unit_price": {
      "type": "number",
      "description": "Actual charged price per unit (= sale_unit_price)"
    },
    "discount_amount_per_unit": {
      "type": "number",
      "default": 0
    },
    "total_discount_amount": {
      "type": "number",
      "default": 0,
      "description": "discount_amount_per_unit \u00d7 quantity"
    },
    "discount_label": {
      "type": "string"
    },
    "price_source": {
      "type": "string",
      "enum": [
        "db_product",
        "fallback"
      ],
      "default": "db_product"
    },
    "fleet_partner_discount_applied": {
      "type": "boolean",
      "default": false
    },
    "fleet_partner_host_id": {
      "type": "string"
    },
    "eligible_owner_type": {
      "type": "string"
    },
    "subtotal": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "shipping_amount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "vehicle_use_type": {
      "type": "string",
      "enum": [
        "personal",
        "host_fleet",
        "dealer",
        "rental",
        "other"
      ],
      "default": "personal"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending_payment"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "pending_payment",
        "paid",
        "processing",
        "shipped",
        "delivered",
        "activation_pending",
        "active",
        "cancelled",
        "refunded",
        "payment_failed",
        "subscription_failed"
      ],
      "default": "pending_payment"
    },
    "tracking_number": {
      "type": "string"
    },
    "carrier": {
      "type": "string"
    },
    "device_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of TelematicsDevice IDs activated against this order"
    },
    "activation_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "activated",
        "partially_activated",
        "failed",
        "subscription_failed"
      ],
      "default": "not_started"
    },
    "refund_status": {
      "type": "string",
      "enum": [
        "none",
        "partial",
        "full"
      ],
      "default": "none"
    },
    "refund_amount": {
      "type": "number",
      "default": 0
    },
    "refund_reason": {
      "type": "string"
    },
    "stripe_refund_id": {
      "type": "string"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_notes": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "shipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "customer_email",
    "package_type",
    "total_amount"
  ]
}