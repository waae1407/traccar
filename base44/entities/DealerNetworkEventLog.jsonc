{
  "name": "DealerNetworkEventLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string"
    },
    "host_id": {
      "type": "string"
    },
    "admin_id": {
      "type": "string"
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "from_status": {
      "type": "string"
    },
    "to_status": {
      "type": "string"
    },
    "changed_by": {
      "type": "string"
    },
    "change_source": {
      "type": "string",
      "enum": [
        "payment",
        "admin_override",
        "system",
        "host_request"
      ],
      "default": "system"
    },
    "event_summary": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "event_summary"
  ]
}